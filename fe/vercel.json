{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@11.25.0 install --frozen-lockfile --prod=false",
  "buildCommand": "npx --yes pnpm@11.25.0 build",
  "outputDirectory": "out",
  "headers": [
    {
