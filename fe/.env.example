# The local app uses http://localhost:3001 by default.
NEXT_PUBLIC_SHAREBILL_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_ENVIRONMENT=local
# Cloud builds: staging or production, full RELEASE_COMMIT (or VERCEL_GIT_COMMIT_SHA),
# and explicit HTTPS API origin/Firebase web configuration are required.
# Admin Google sign-in. Values below target the local Auth Emulator.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-sharebill
NEXT_PUBLIC_FIREBASE_API_KEY=demo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-sharebill.firebaseapp.com
