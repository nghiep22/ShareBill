{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@11.25.0 install --frozen-lockfile --prod=false",
  "buildCommand": "npx --yes pnpm@11.25.0 build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": { "includeFiles": "openapi.json", "maxDuration": 240 }
  },
  "crons": [{ "path": "/api/internal/maintenance", "schedule": "0 20 * * *" }],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
