{
  "name": "@sharebill/be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "emulators": "firebase emulators:start --project demo-sharebill --only auth,firestore",
    "test:emulator": "vitest run --no-file-parallelism test/emulator.test.ts test/check-database.emulator.test.ts test/migration-users.emulator.test.ts test/migration-slices.emulator.test.ts test/pagination.emulator.test.ts",
    "db:seed": "tsx scripts/seed-database.ts",
    "db:check": "tsx scripts/check-database.ts",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.9.4",
    "@fastify/swagger-ui": "^5.2.6",
    "fastify": "^5.6.0",
    "firebase-admin": "^13.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "firebase-tools": "^15.36.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
