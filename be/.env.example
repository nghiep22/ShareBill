PORT=3001
APP_ORIGIN=http://localhost:3000
APP_ENVIRONMENT=local
# Cloud: APP_ENVIRONMENT=staging or production, full 40-character SHA below
# (or VERCEL_GIT_COMMIT_SHA), HTTPS APP_ORIGIN, no Emulator hosts.
# RELEASE_COMMIT=<commit hash of deployed build>
# Set a separate secret of at least 32 characters outside Emulator environments.
# CURSOR_SIGNING_SECRET=
FIREBASE_PROJECT_ID=demo-sharebill
FIREBASE_WEB_API_KEY=demo
FIREBASE_STORAGE_BUCKET=demo-sharebill.appspot.com
# Local development: run Firebase Auth/Firestore emulators; do not set these in production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Production: use workload identity or set the following server-only credentials in the host secret store.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
